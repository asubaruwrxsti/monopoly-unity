<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameHud.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- ============================================================ in-game HUD -->
        <ui:VisualElement name="hud" class="hud hidden" picking-mode="Ignore">
            <ui:VisualElement name="player-bar" class="player-bar" picking-mode="Ignore" />
            <ui:Label name="toast" class="toast glass dark" picking-mode="Ignore" />

            <ui:VisualElement name="announce" class="announce" picking-mode="Ignore">
                <ui:Label name="announce-title" class="announce__title" picking-mode="Ignore" />
                <ui:Label name="announce-sub" class="announce__sub" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="bottom" picking-mode="Ignore">
                <ui:Label name="status-label" class="status-pill glass dark" picking-mode="Ignore" />
                <ui:VisualElement name="secondary-actions" class="secondary-actions" picking-mode="Ignore">
                    <ui:Button name="pay-fine-btn" text="Pay $50" class="btn yellow" />
                    <ui:Button name="use-card-btn" text="Use Jail Card" class="btn yellow" />
                    <ui:Button name="decline-btn" text="Pass" class="btn gray" />
                    <ui:Button name="bankrupt-btn" text="Go Bankrupt" class="btn red" />
                </ui:VisualElement>
                <ui:VisualElement class="primary-row" picking-mode="Ignore">
                    <ui:Button name="roll-btn" class="roll-btn">
                        <ui:Label text="ROLL" class="roll-btn__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="buy-btn" text="BUY" class="btn green big" />
                    <ui:Button name="pay-debt-btn" text="PAY" class="btn green big" />
                    <ui:Button name="end-turn-btn" text="END TURN" class="btn blue big" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="corner-left" picking-mode="Ignore">
                <ui:Button name="manage-btn" text="Properties" class="btn white pill" />
                <ui:Button name="log-btn" text="Log" class="btn white pill" />
            </ui:VisualElement>
            <ui:VisualElement class="corner-right" picking-mode="Ignore">
                <ui:Button name="speed-btn" text="1x" class="btn white pill" />
                <ui:Button name="leave-btn" text="Leave" class="btn white pill" />
            </ui:VisualElement>

            <ui:VisualElement name="log-drawer" class="log-drawer glass hidden">
                <ui:Label text="Game log" class="panel-title small" />
                <ui:ScrollView name="log" class="log" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ main menu -->
        <ui:VisualElement name="menu-screen" class="screen" picking-mode="Ignore">
            <ui:VisualElement class="side-sheet glass">
                <ui:VisualElement class="logo">
                    <ui:Label text="MONOPOLY" class="logo__text" />
                </ui:VisualElement>
                <ui:Label text="London Edition" class="tagline" />
                <ui:Label text="Your name" class="field-label" />
                <ui:TextField name="menu-name" class="field" max-length="16" />
                <ui:Button name="menu-local-btn" text="Play" class="btn green big wide" />
                <ui:Button name="menu-host-btn" text="Host online game" class="btn blue wide" />
                <ui:Button name="menu-join-btn" text="Join online game" class="btn blue wide" />
                <ui:Button name="menu-quit-btn" text="Quit" class="btn gray wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ host / join -->
        <ui:VisualElement name="connect-screen" class="screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="side-sheet glass">
                <ui:Label name="connect-heading" text="Join a game" class="panel-title" />
                <ui:Label text="Connection" class="field-label" />
                <ui:VisualElement class="segmented">
                    <ui:Button name="mode-online-btn" text="Online code" class="btn gray selected" />
                    <ui:Button name="mode-lan-btn" text="LAN address" class="btn gray" />
                </ui:VisualElement>
                <ui:Label name="connect-address-label" text="Join code" class="field-label" />
                <ui:TextField name="connect-address" class="field" />
                <ui:Label name="connect-hint" class="hint" />
                <ui:Label name="connect-error" class="error hidden" />
                <ui:VisualElement class="row">
                    <ui:Button name="connect-back-btn" text="Back" class="btn gray" />
                    <ui:Button name="connect-go-btn" text="Join" class="btn green" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ lobby -->
        <ui:VisualElement name="lobby-screen" class="screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="side-sheet wide glass">
                <ui:Label name="lobby-heading" text="New game" class="panel-title" />
                <ui:VisualElement name="lobby-code-box" class="code-box">
                    <ui:VisualElement>
                        <ui:Label name="lobby-code-label" text="Join code" class="field-label" style="margin-top: 0;" />
                        <ui:Label name="lobby-code" class="code-value" />
                    </ui:VisualElement>
                    <ui:Button name="lobby-copy-btn" text="Copy" class="btn white pill" />
                </ui:VisualElement>
                <ui:Label text="Players · pick your token" class="field-label" />
                <ui:ScrollView name="lobby-seats" class="seat-list" />
                <ui:VisualElement name="lobby-edit-row" class="row">
                    <ui:Button name="lobby-add-human-btn" text="+ Player" class="btn white" />
                    <ui:Button name="lobby-add-cpu-btn" text="+ Computer" class="btn white" />
                </ui:VisualElement>
                <ui:Label name="lobby-status" class="hint centered" />
                <ui:VisualElement class="row">
                    <ui:Button name="lobby-leave-btn" text="Back" class="btn gray" />
                    <ui:Button name="lobby-start-btn" text="Start!" class="btn green big" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ dialogs -->
        <ui:VisualElement name="deed-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement class="modal deed glass">
                <ui:VisualElement name="deed-image" class="deed-image" />
                <ui:VisualElement class="deed-info">
                    <ui:Label name="deed-title" class="deed-title" />
                    <ui:VisualElement name="deed-group" class="deed-group" />
                    <ui:VisualElement name="deed-rows" />
                    <ui:Label name="deed-note" class="hint" />
                    <ui:VisualElement class="row">
                        <ui:Button name="deed-decline-btn" text="Pass" class="btn gray" />
                        <ui:Button name="deed-buy-btn" text="Buy" class="btn green" />
                        <ui:Button name="deed-close-btn" text="Close" class="btn gray" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="card-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement name="game-card" class="modal game-card glass">
                <ui:Label name="card-header" class="game-card__header" />
                <ui:VisualElement class="game-card__body">
                    <ui:Label name="card-player" class="hint centered" />
                    <ui:Label name="card-text" class="game-card__text" />
                    <ui:Button name="card-ok-btn" text="OK" class="btn green wide" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="manage-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement class="modal manage glass">
                <ui:Label text="Your properties" class="panel-title" />
                <ui:Label name="manage-summary" class="hint" />
                <ui:ScrollView name="manage-list" class="manage-list" />
                <ui:Button name="manage-close-btn" text="Done" class="btn green wide" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="message-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement class="modal message glass">
                <ui:Label name="message-title" class="panel-title centered" />
                <ui:Label name="message-text" class="hint centered" />
                <ui:VisualElement class="row">
                    <ui:Button name="message-cancel-btn" text="Cancel" class="btn gray" />
                    <ui:Button name="message-ok-btn" text="OK" class="btn green" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="player-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement class="modal sheet glass">
                <ui:VisualElement class="sheet-header">
                    <ui:VisualElement name="player-avatar" class="sheet-avatar" />
                    <ui:VisualElement class="sheet-header__text">
                        <ui:Label name="player-name" class="panel-title" />
                        <ui:Label name="player-cash" class="sheet-cash" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="player-list" class="sheet-list" />
                <ui:VisualElement class="row">
                    <ui:Button name="player-close-btn" text="Close" class="btn gray" />
                    <ui:Button name="player-trade-btn" text="Propose trade" class="btn blue" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="trade-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement class="modal trade glass">
                <ui:Label name="trade-title" class="panel-title" />
                <ui:VisualElement class="trade-columns">
                    <ui:VisualElement class="trade-col">
                        <ui:Label name="trade-give-label" class="trade-col__title" />
                        <ui:ScrollView name="trade-give-list" class="trade-list" />
                        <ui:VisualElement name="trade-give-stepper" class="stepper">
                            <ui:Button name="trade-give-minus" text="-" class="btn gray step" />
                            <ui:Label name="trade-give-cash" class="stepper__value" />
                            <ui:Button name="trade-give-plus" text="+" class="btn gray step" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="trade-col">
                        <ui:Label name="trade-get-label" class="trade-col__title" />
                        <ui:ScrollView name="trade-get-list" class="trade-list" />
                        <ui:VisualElement name="trade-get-stepper" class="stepper">
                            <ui:Button name="trade-get-minus" text="-" class="btn gray step" />
                            <ui:Label name="trade-get-cash" class="stepper__value" />
                            <ui:Button name="trade-get-plus" text="+" class="btn gray step" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="trade-note" class="hint centered" />
                <ui:VisualElement name="trade-propose-row" class="row">
                    <ui:Button name="trade-cancel-btn" text="Cancel" class="btn gray" />
                    <ui:Button name="trade-send-btn" text="Send offer" class="btn green" />
                </ui:VisualElement>
                <ui:VisualElement name="trade-answer-row" class="row">
                    <ui:Button name="trade-reject-btn" text="Decline" class="btn red" />
                    <ui:Button name="trade-accept-btn" text="Accept" class="btn green" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="busy-modal" class="modal-backdrop glass backdrop hidden">
            <ui:VisualElement class="modal message glass">
                <ui:Label name="busy-text" text="Connecting..." class="panel-title centered" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
